<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mdframe.forge.plugin.system.mapper.SysDictDataMapper">

    <select id="countByDictTypeAndValue" resultType="int">
        SELECT COUNT(1)
        FROM sys_dict_data
        WHERE dict_type = #{dictType}
          AND dict_value = #{dictValue}
          AND del_flag = 0
        <if test="excludeDictCode != null">
            AND dict_code &lt;&gt; #{excludeDictCode}
        </if>
    </select>

</mapper>
