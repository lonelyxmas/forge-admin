<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>forge-plugin-parent</artifactId>
        <groupId>com.mdframe.forge</groupId>
        <version>${revision}</version>
    </parent>
    <artifactId>forge-plugin-capability-open-gateway</artifactId>
    <name>forge-plugin-capability-open-gateway</name>
    <description>Forge 能力开放网关：外部 REST 调用的认证、授权与受控编排</description>

    <dependencies>
        <dependency>
            <groupId>com.mdframe.forge</groupId>
            <artifactId>forge-plugin-capability-secure-actions</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mdframe.forge</groupId>
            <artifactId>forge-starter-openapi-security</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mdframe.forge</groupId>
            <artifactId>forge-starter-job</artifactId>
        </dependency>

        <!-- 幂等快照清理 Handler 专用；optional 避免传递到不启调度器的服务 -->
        <dependency>
            <groupId>com.mdframe.forge</groupId>
            <artifactId>forge-plugin-job</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
