# 生产环境配置
# 静态资源目录
VITE_PUBLIC_PATH=/forge-h5
# 路由前缀
VITE_BASE_URL=/forge-h5
# map文件
VITE_DEVTOOL=none

# 请求地址前缀
VITE_REQUEST_PREFIX=/forge-h5-api

# App 服务代理地址（生产环境由 Nginx 代理，此处留空）
VITE_HTTP_PROXY_TARGET=

# 客户端配置
VITE_USER_CLIENT=h5
VITE_APP_ID=forge_h5
VITE_APP_SECRET=forge_h5123

# 企业微信工作台免登：填写后端 sys_social_config.connection_code，留空则禁用免登
VITE_WECOM_CONNECTION_CODE=
