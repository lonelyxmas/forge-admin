# 开发环境配置
# 端口号
VITE_HTTP_PORT=3000

# 请求地址前缀
VITE_REQUEST_PREFIX=/dev-api

# 图片host地址
VITE_RESOURCE_HOST=/

# 模板文件下载地址
VITE_TEMPLATE_PATH=/templates

# 主服务代理地址
VITE_HTTP_PROXY_TARGET=http://127.0.0.1:8580/

# 流程服务代理地址
VITE_FLOW_PROXY_TARGET=http://127.0.0.1:8081/
# 客户端配置（新增）
# 客户端AppId
VITE_APP_ID=pc
# 登录设备标识（oauth2/免登登录一致）
VITE_USER_CLIENT=pc
# 企业微信PC客户端工作台免登：填写后端 sys_social_config.connection_code，留空则禁用免登
VITE_WECOM_CONNECTION_CODE=wechat_open-4

# 报表子系统单点登录配置
VITE_SSO_BRIDGE_ROUTE=/report/design
VITE_SSO_TARGET_CLIENT=forge_report
VITE_SSO_TARGET_BASE_URLS={"forge_report":"http://localhost:3021/forge-report"}
VITE_SSO_DEFAULT_REDIRECTS={"forge_report":"/project/items"}
VITE_REPORT_UI_BASE_URL=http://localhost:3021/forge-report
VITE_REPORT_UI_DEFAULT_REDIRECT=/project/items
VITE_REPORT_UI_HOST_FALLBACK=localhost:3021
VITE_REPORT_UI_PATH_PREFIX=/forge-report
